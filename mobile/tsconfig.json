{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "moduleDetection": "force"
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/**/*.ts"
  ],
  "exclude": [
    "../dist",
    "../tests",
    "**/node_modules",
    "android/**"
  ]
}
