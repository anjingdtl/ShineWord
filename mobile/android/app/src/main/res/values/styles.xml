<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- targetSdk 35+ forces edge-to-edge, which silently disables the
             activity's windowSoftInputMode=adjustResize: the on-screen
             keyboard then covers the action composer and every form field.
             Opting out restores resize-on-keyboard app-wide (input UX over
             edge-to-edge cosmetics). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
